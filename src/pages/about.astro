---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../data/projects';
import { getSeriesDocs } from '../data/articles';

const series = await getSeriesDocs();
---

<BaseLayout
  title="About Us | EngineerExperiences"
  description="Who writes EngineerExperiences, what is documented here, and how the site itself is built and deployed."
>
  <section class="section">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        <li>
          <a href="/">Home</a>
          <span class="separator" aria-hidden="true">/</span>
        </li>
        <li>
          <span class="current" aria-current="page">About Us</span>
        </li>
      </ol>
    </nav>

    <div class="section-heading">
      <span class="eyebrow">About</span>
      <h1>About Us</h1>
      <p>
        EngineerExperiences is my engineering documentation site. I write up the embedded systems,
        firmware and tooling work as I build it, so the reasoning behind a design is captured next to
        the design instead of in a chat window that is lost a week later.
      </p>
    </div>

    <div class="card-grid">
      {
        PROJECTS.map((project) => (
          <article class="card">
            <div class="badge-row">
              {project.badges.map((badge) => (
                <span class="badge">{badge}</span>
              ))}
            </div>
            <h3>
              <a href={`/projects/${project.slug}/`}>{project.name}</a>
            </h3>
            <p>{project.summary}</p>
            <div class="card-footer">
              <a href={`/projects/${project.slug}/`}>
                Read the documentation <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <span class="eyebrow">Articles</span>
      <h2>Written series</h2>
      <p>
        Not everything belongs to a single project, so longer write-ups live in their own series
        next to the documentation.
      </p>
    </div>

    <div class="card-grid card-grid--series">
      {
        series.map((entry) => (
          <article class="card">
            <div class="badge-row">
              {entry.meta.tags.map((tag) => (
                <span class="badge">{tag}</span>
              ))}
            </div>
            <h3>
              <a href={`/articles/${entry.meta.slug}/`}>{entry.meta.name}</a>
            </h3>
            <p>{entry.meta.summary}</p>
            <span class="card-meta">
              {entry.parts.length} {entry.parts.length === 1 ? 'part' : 'parts'} ·{' '}
              {entry.meta.tagline}
            </span>
            <div class="card-footer">
              <a href={`/articles/${entry.meta.slug}/`}>
                Read the series <span aria-hidden="true">→</span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <span class="eyebrow">This site</span>
      <h2>How EngineerExperiences is built</h2>
    </div>

    <div class="card-grid">
      <article class="card">
        <h3>Static Astro</h3>
        <p>
          The whole site is pre-rendered with Astro: every project chapter, article part and search
          entry is produced at build time, so there is no application server behind it.
        </p>
        <span class="card-meta">Astro · Markdown content collections · TypeScript</span>
      </article>

      <article class="card">
        <h3>AWS S3 and CloudFront</h3>
        <p>
          The build is deployed to Amazon S3 on every push and served through CloudFront. GitHub
          Actions authenticates with OIDC and assumes a restricted IAM role, so no AWS access key is
          stored in the repository.
        </p>
        <div class="card-footer">
          <a href="/articles/aws-s3-cloudfront-deployment/">
            Read the deployment series <span aria-hidden="true">→</span>
          </a>
        </div>
      </article>

      <article class="card">
        <h3>Source code</h3>
        <p>
          The site, the documentation and the deployment workflow live in one public repository, so
          every page can be traced back to the commit that published it.
        </p>
        <div class="card-footer">
          <a href="https://github.com/isarwar93" rel="noreferrer">
            github.com/isarwar93 <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    </div>
  </section>
</BaseLayout>
