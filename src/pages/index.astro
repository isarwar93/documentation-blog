---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SeriesCard from '../components/SeriesCard.astro';
import { getSeriesDocs } from '../data/articles';
import { getProjectDocs } from '../data/docs';

const series = await getSeriesDocs();
const projectDocs = await getProjectDocs();
const partTotal = series.reduce((total, entry) => total + entry.parts.length, 0);
const projects = projectDocs.map(({ meta, chapters }) => ({
  meta,
  chapterCount: chapters.length,
  highlights: chapters.slice(0, 3).map((chapter) => ({
    title: chapter.title,
    href: chapter.href,
  })),
}));

const chapterTotal = projectDocs.reduce(
  (total, project) => total + project.chapters.length,
  0,
);
---

<BaseLayout
  title="EngineerExperiences | Engineering Documentation & Lab Notes"
  description="Architecture notes, firmware deep dives and deployment guides for embedded systems, IoT sensors and biosignal monitoring platforms."
>
  <header class="hero">
    <div class="hero-copy">
      <span class="eyebrow">Embedded systems · IoT Devices · Sensors</span>
      <h1>Documentation blog, for engineers, by engineers</h1>
      <p class="lead">
        This blog is about architecture notes, firmware deep dives and deployment guides. 
        It is divided into two sections: articles and projects. Where, articles will be having a focus on general learnings, on the other hand, 
        projects will be discussing architectures and implementation details with practical examples. 
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/projects/">
          Explore projects <span aria-hidden="true">→</span>
        </a>

        <a class="button button-primary" href="/articles/">
          Explore articles <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

  </header>

  <section class="section">
    <div class="section-heading">
      <span class="eyebrow">{projects.length} {projects.length === 1 ? 'project' : 'projects'} · {chapterTotal} chapters.</span>
      <h2>Projects</h2>
      <p>
        Each project is documented from the hardware layer upwards: peripherals and pin
        maps, firmware architecture, data handling and deployment. Each project 
        has a linked repository to get its related data and firmware. 
        Following are the projects with their short desctriptions that
        have been documented in this blog:
      </p>
    </div>

    <div class="card-grid">
      {
        projects.map((project) => (
          <ProjectCard
            project={project.meta}
            chapterCount={project.chapterCount}
            highlights={project.highlights}
          />
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <span class="eyebrow">{series.length} {series.length === 1 ? 'series' : 'series'} · {partTotal} parts.</span>
      <h1>Articles</h1>
      <p>
        Whichever experiences won't fit into a project, will be documented as an article. Following are the articles with their short descriptions that
        have been documented in this blog:
      </p>
    </div>

    <div class="card-grid card-grid--series">
      {series.map((entry) => <SeriesCard series={entry} />)}
    </div>
  </section>

</BaseLayout>
