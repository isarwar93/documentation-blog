---
import EntryCard from './EntryCard.astro';
import { articleDateValue, formatArticleDate, type SeriesDocs } from '../data/articles';

interface Props {
  /** Series rendered as a card in the article index. */
  series: SeriesDocs;
}

const { series } = Astro.props;
const { meta, parts } = series;

const href = `/articles/${meta.slug}/`;

/* The landing chapter links to the card's own href, so it is not repeated. */
const links = parts
  .filter((part) => part.href !== href)
  .map((part) => ({ title: part.title, href: part.href }));
---

<EntryCard
  href={href}
  title={meta.name}
  badges={meta.tags}
  summary={meta.summary}
  links={links}
  count={`${parts.length} ${parts.length === 1 ? 'part' : 'parts'}`}
  tagline={meta.tagline}
  published={{
    value: articleDateValue(meta.pubDate),
    label: formatArticleDate(meta.pubDate),
  }}
  action="Read the series"
/>
