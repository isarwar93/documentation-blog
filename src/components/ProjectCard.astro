---
import EntryCard from './EntryCard.astro';
import type { ProjectMeta } from '../data/projects';

interface Props {
  project: ProjectMeta;
  /** Number of documentation chapters available for this project. */
  chapterCount: number;
  /** First chapters of the project, linked for quick access. */
  highlights: { title: string; href: string }[];
}

const { project, chapterCount, highlights } = Astro.props;
const href = `/projects/${project.slug}/`;
---

<EntryCard
  href={href}
  title={project.name}
  badges={project.badges}
  summary={project.summary}
  links={highlights}
  count={`${chapterCount} ${chapterCount === 1 ? 'chapter' : 'chapters'}`}
  tagline={project.tagline}
  action="Read the documentation"
/>
