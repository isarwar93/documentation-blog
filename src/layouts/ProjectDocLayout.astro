---
import BaseLayout from './BaseLayout.astro';
import DocSidebar from '../components/DocSidebar.astro';
import TocScrollSpy from '../components/TocScrollSpy.astro';
import { getProjectDocs } from '../data/docs';
import { getSidebarSections } from '../data/sidebar';
import type { TocHeading } from '../data/toc';

interface Props {
  /** Project folder slug the current chapter belongs to. */
  projectSlug: string;
  /** Chapter slug inside the project folder, e.g. `architecture` or `index`. */
  currentSlug: string;
  /** Chapter title used for the document title and breadcrumb. */
  title: string;
  description?: string;
  /** Headings of the rendered Markdown. */
  headings?: TocHeading[];
}

const { projectSlug, currentSlug, title, description, headings = [] } = Astro.props;

const docs = await getProjectDocs();

/** Sidebar tree: every project with its chapters in frontmatter order. */
const groups = docs.map(({ meta, chapters }) => ({
  project: meta,
  pages: chapters.map((chapter) => ({
    slug: chapter.slug,
    title: chapter.title,
    order: chapter.order,
    href: chapter.href,
  })),
}));

const activeGroup = groups.find((group) => group.project.slug === projectSlug);
const activeIndex = activeGroup?.pages.findIndex((page) => page.slug === currentSlug) ?? -1;
const previousPage = activeIndex > 0 ? activeGroup?.pages[activeIndex - 1] : undefined;
const nextPage =
  activeGroup && activeIndex >= 0 && activeIndex < activeGroup.pages.length - 1
    ? activeGroup.pages[activeIndex + 1]
    : undefined;

const isIndexPage = currentSlug === 'index';
const projectLabel = activeGroup?.project.shortName ?? projectSlug;
const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects/' },
  ...(isIndexPage ? [] : [{ label: projectLabel, href: `/projects/${projectSlug}/` }]),
];

const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

/** Sidebar tree: projects and article series, shared with `ArticleLayout`. */
const sections = await getSidebarSections({
  section: 'projects',
  slug: projectSlug,
  part: currentSlug,
});
---

<BaseLayout
  title={`${title} | ${activeGroup?.project.name ?? 'Documentation'} | EngineerExperiences`}
  description={description}
  hasSidebar
>
  <div class="doc-layout">
    <DocSidebar sections={sections} />

    <div class="doc-main">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <ol>
          {
            crumbs.map((crumb) => (
              <li>
                <a href={crumb.href}>{crumb.label}</a>
                <span class="separator" aria-hidden="true">
                  /
                </span>
              </li>
            ))
          }
          <li>
            <span class="current" aria-current="page">{title}</span>
          </li>
        </ol>
      </nav>

      <article class="sl-markdown-content">
        <slot />
      </article>

      {
        (previousPage || nextPage) && (
          <nav class="pagination" aria-label="Documentation pagination">
            {previousPage ? (
              <a class="pagination-link" href={previousPage.href}>
                <span class="label">
                  <span aria-hidden="true">←</span> Previous
                </span>
                <span class="title">{previousPage.title}</span>
              </a>
            ) : null}
            {nextPage ? (
              <a class="pagination-link is-next" href={nextPage.href}>
                <span class="label">
                  Next <span aria-hidden="true">→</span>
                </span>
                <span class="title">{nextPage.title}</span>
              </a>
            ) : null}
          </nav>
        )
      }
    </div>

    <aside class="doc-toc" aria-labelledby="toc-heading">
      <h2 id="toc-heading">On this page</h2>
      <ul>
        {
          tocItems.map((heading) => (
            <li class={`toc-depth-${heading.depth}`}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))
        }
      </ul>
    </aside>
  </div>
</BaseLayout>

<TocScrollSpy />
